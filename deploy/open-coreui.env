# Open CoreUI Deployment Configuration
# HTTP Server on port 15565

# Server Configuration
HOST=0.0.0.0
PORT=15565
ENV=production

# Disable Authentication (no auth required)
WEBUI_AUTH=false
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=false
ENABLE_API_KEY=false

# Make user 'x' an admin (requires manual database setup or first user = admin)
DEFAULT_USER_ROLE=admin

# Database (SQLite)
DATABASE_URL=sqlite:///data/adapt/platform/aiml/open-coreui/deploy/data.sqlite3

# Configuration Directory
CONFIG_DIR=/data/adapt/platform/aiml/open-coreui/deploy

# Static files will be served from build/
STATIC_DIR=/data/adapt/platform/aiml/open-coreui/frontend/build

# Logging
GLOBAL_LOG_LEVEL=INFO

# WebUI Settings
WEBUI_NAME=Open CoreUI
